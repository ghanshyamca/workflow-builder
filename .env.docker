# Docker Environment Variables
# Copy to .env when running with docker-compose

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=workflow_builder
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=MiPp0aoysAqRynKgAYLAx98tEAcMNRrlf3Ko5iw4giC
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=bpIZI2QuONZSeL4uzrJhjnupgFOXMxfzna7UaaOjhe2
JWT_REFRESH_EXPIRE=30d

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Webhook Configuration
WEBHOOK_SECRET_KEY=your-webhook-secret-key
WEBHOOK_TIMEOUT=30000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@workflowbuilder.com

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-slack-token
SLACK_WEBHOOK_URL=

# External API Configuration
HTTP_REQUEST_TIMEOUT=30000
HTTP_REQUEST_MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Frontend URL
FRONTEND_URL=http://localhost:3001

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000
VITE_APP_NAME=Workflow Builder
