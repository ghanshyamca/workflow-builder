# Example production environment file
# Copy this to .env and fill secrets before running in production.
# Do NOT commit your real .env into version control.

# Server
NODE_ENV=production
PORT=3000

# Database (PostgreSQL)
# Set these to your production DB credentials
DB_HOST=postgres
DB_PORT=5432
DB_NAME=workflow_builder
DB_USER=postgres
DB_PASSWORD=REPLACE_ME_DB_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT / Auth secrets (REQUIRED in production)
JWT_SECRET=REPLACE_ME_STRONG_JWT_SECRET
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=REPLACE_ME_REFRESH_SECRET
JWT_REFRESH_EXPIRE=30d

# Webhook secret used to validate external webhook calls
WEBHOOK_SECRET_KEY=REPLACE_ME_WEBHOOK_SECRET
WEBHOOK_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Mail / SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=REPLACE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@example.com

# Frontend / Vite settings
VITE_API_BASE_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000
VITE_APP_NAME=Workflow Builder

# CORS
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# Optional integrations
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# HTTP requests
HTTP_REQUEST_TIMEOUT=30000
HTTP_REQUEST_MAX_RETRIES=3

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
